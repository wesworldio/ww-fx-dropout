{
  "name": "wesworld-fx-desktop",
  "version": "2.1.4",
  "description": "WesWorld FX - High-performance desktop face filters app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "io.wesworld.fx",
    "productName": "WesWorld FX",
    "copyright": "Copyright © 2026 WesWorld",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "assets/**/*",
      "static/**/*",
      "scenes/**/*",
      "config.json",
      "!**/*.md",
      "!archive/**/*",
      "!docs/**/*",
      "!examples/**/*",
      "!tests/**/*",
      "!wasm/src/**/*",
      "!wasm/build/**/*",
      "!scripts/**/*",
      "!.git/**/*"
    ],
    "extraResources": [
      {
        "from": "static/wasm",
        "to": "wasm",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "type": "distribution",
      "minimumSystemVersion": "10.13.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WesWorld FX"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "icon": "build/icons"
    }
  },
  "keywords": [
    "face-filters",
    "camera",
    "webassembly",
    "filters",
    "real-time"
  ],
  "author": "WesWorld",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {}
}
